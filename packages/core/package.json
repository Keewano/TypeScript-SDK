{
  "name": "@keewano/core",
  "version": "1.0.0-41",
  "description": "Platform-agnostic core for Keewano TypeScript SDK (encoding, dispatcher, transport, identity, types).",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:prod": "tsc -p tsconfig.prod.json",
    "clean": "rimraf dist"
  },
  "keywords": [
    "analytics",
    "keewano",
    "sdk",
    "core"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Keewano/TypeScript-SDK.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Keewano/TypeScript-SDK#readme",
  "bugs": "https://github.com/Keewano/TypeScript-SDK/issues",
  "license": "MIT"
}
